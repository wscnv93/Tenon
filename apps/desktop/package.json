{
  "name": "@tenon/desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node ../../scripts/fetch-pi.mjs && node ../../scripts/fetch-codegraph.mjs",
    "icons": "node ../../scripts/gen-icons.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac",
    "release": "bash ../../scripts/release.sh"
  },
  "build": {
    "appId": "com.tenon.desktop",
    "productName": "Tenon",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/simple-git/**"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor"
      },
      {
        "from": "../../packages/pi-extensions",
        "to": "tenon-gate"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "afterPack": "../../scripts/after-pack.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "simple-git": "^3.36.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/stream": "^4.4.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jotai": "^3.0.0",
    "marked": "^18.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remend": "^1.3.1",
    "shiki": "^4.4.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
